# Only build inputs are sent to the daemon or exported to the CI build cache.
**
!Dockerfile
!.dockerignore
!go.mod
!go.sum
!main.go
!doc.go
!api/
!api/**
!cache/
!cache/**
!cmd/
!cmd/**
!db/
!db/**
!queue/
!queue/**
!redis/
!redis/**
!services/
!services/**
!xutil/
!xutil/**
!scripts/
scripts/**
!scripts/prepare-onnxruntime-linux.sh
!scripts/check-onnxruntime-api.sh
!storage/
storage/**
!storage/*.go
!storage/ui/
storage/ui/**
!storage/ui/package.json
!storage/ui/package-lock.json
!storage/ui/vite.config.js
!storage/ui/src/
!storage/ui/src/**
!storage/ui/scripts/
!storage/ui/scripts/**
!storage/ui/dist/
storage/ui/dist/**
!storage/ui/dist/keep.txt
!storage/views/
!storage/views/**
!storage/static/
!storage/static/**

# Keep local configuration, trained weights and private keys out even if they
# are accidentally placed under a source directory above.
**/.env*
**/*.env
**/.app.toml*
**/*.toml
**/node_modules
**/*.onnx
**/*.pt
**/*.pth
**/*.so
**/*.so.*
**/*.dylib
**/*.dll
**/*.pem
**/*.key
**/*keyring*.json
**/*.sql
