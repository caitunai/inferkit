port="8080"
mode="dev"
url="http://localhost:8080"
key="key_must_length_32"

[server]
# 0s preserves net/http's unlimited default. Set a positive duration to opt in.
readHeaderTimeout="0s"
readTimeout="0s"
writeTimeout="0s"
idleTimeout="0s"
shutdownTimeout="5s"

[logger]
level="info"

[storage]
path="/path/to/uploads"

[db]
username="username"
password="password"
database="db_name"
host="localhost"
port="3306"
tls=false

[db.table]
prefix="ifk"

[redis]
host="127.0.0.1"
username=""
password=""
port="6379"
db=0
prefix="app"
pingTimeout="3s"
dialTimeout="3s"
readTimeout="3s"
writeTimeout="3s"
poolTimeout="4s"
poolSize=0
minIdleConnections=2
maxIdleConnections=0
connectionMaxIdleTime="5m"
connectionMaxLifetime="30m"

[redis.tls]
enabled=false
serverName=""

[queue]
prefix="test"
topics=["default"]
shutdownTimeout="5s"
streamMaxLength=100000
# Approximate retention: size for worst-case lag because trimming can evict old pending entries.
maxRetries=3
retryInitialInterval="250ms"
retryMaxInterval="2s"
deadLetterSuffix="dead-letter"
deadLetterMaxLength=10000

[queue.consumer]
name="default"
group="default"
# Increase only when jobs are independent and do not require strict ordering.
concurrency=1
nackResendInterval="1s"
blockTime="1s"
claimInterval="30s"
claimBatchSize=100
# Must exceed the longest expected job execution, including in-process retries.
maxIdleTime="5m"
checkConsumersInterval="1m"
consumerTimeout="5m"

[oauth]
key="oauth_app_id_or_key"
secret="oauth_app_secret"
api="https://www.example.com"
publicKeyPath="/path/to/oauth-public.key"

[auth.api]
# api-token create signs HS256 tokens with this secret (at least 32 bytes).
# Keep the real secret outside version control. Default token lifetime: 365 days.
secret="32-chars-length"
audience="name of this api"
issuers=[ "allowed name of issuer" ]

[ui]
assetMode="embedded"
viteDevOrigin="http://127.0.0.1:5173"

[configcenter]
enabled=false
username=""
password=""

[configload]
enabled=false

# Targets are loaded and merged in declaration order. Later targets override
# matching values from earlier targets. Each target selects its own source.
[[configload.targets]]
source="database"
namespace="shared"
environment="base"

[[configload.targets]]
source="http"
namespace="my-service"
environment="production"

[configload.targets.http]
baseURL="https://primary-config.example.com"
apiKeyEnv="PRIMARY_CONFIG_API_KEY"
timeout="5s"

[[configload.targets]]
source="http"
namespace="regional-service"
environment="production"

[configload.targets.http]
baseURL="https://regional-config.example.com"
apiKeyEnv="REGIONAL_CONFIG_API_KEY"
timeout="8s"

[configcrypt]
enabled=false
provider="file"
activeKey="config-key-v1"
keyring="/absolute/path/to/config-center-keys.json"

[image.filter]
# cpu 保持现有结果；auto 在 macOS ARM 尝试 CoreML，其他平台使用 CPU。
provider="cpu"
coremlComputeUnits="ALL"
# 0 or "auto": CPU uses a four-thread starting budget; CoreML keeps its small pool.
# A positive value (e.g. 4) is capped at detected CPUs. Concurrency/admission remain automatic.
threads="auto"
# Complete at most ten warmup runs before serving; 0 disables startup warmup.
warmupRuns=3
# Uses the system user cache on macOS; independent of the HTTP result cache.
coremlCache=true
model="/path/to/artwork_fp32"
# Defaults to true when db.database is configured. Apply Atlas migrations first.
recordResults=true
# Optional native CPU library path. macOS Homebrew is detected automatically.
library=""
timeout="30s"
maxBytes=10485760
maxPixels=20000000
# Set true temporarily for performance comparisons; also disables in-flight coalescing.
bypassCache=false
cacheEntries=1024
cacheTTL="5m"

[image.review]
# Separate administrator access; detection API tokens cannot annotate data.
enabled=false
username="image-review-admin"
password="replace-with-at-least-16-random-characters"

[image.ocr]
# cpu 保持现有结果；auto 在 macOS ARM 尝试 CoreML，其他平台使用 CPU。
# Debian 13 amd64 image + Intel AVX2: explicit "openvino" selects CPU FP32.
# OpenVINO is opt-in; auto keeps its existing platform selection.
provider="cpu"
# Empty inherits provider. On macOS ARM, compare detectionProvider="auto" and recognitionProvider="cpu".
detectionProvider=""
recognitionProvider=""
coremlComputeUnits="ALL"
# Existing `serve` command exposes POST /api/image/ocr when enabled.
enabled=false
# Prepare with scripts/prepare-ocr-models.sh; medium remains the default.
modelSize="medium" # medium or small
# Optional custom paths override the modelSize preset. Use the matching dictionary and pins.
# detectionModel="/absolute/path/det.onnx"
# recognitionModel="/absolute/path/rec.onnx"
# dictionary="/absolute/path/dict.txt"
warmupRuns=3 # 0 disables; maximum 10 cycles, bounded to 30 seconds.
coremlCache=true # Per-model compilation cache in the system user cache directory.
recognitionBatchSize=4 # Same-width, adaptive bounded batches; 0/1 selects singleton runs.
# Optional SHA-256 pins for the exact deployed files.
detectionSHA256=""
recognitionSHA256=""
dictionarySHA256=""
# Must resolve to the same native library as image.filter.library when both run.
library=""
# CPU threads, inference concurrency and request admission are automatic.
timeout="60s"
maxBytes=10485760
maxPixels=20000000
detectionMaxSide=960
recognitionHeight=48
recognitionMaxWidth=2048
maxCandidates=1000
maxLines=1000
detectionThreshold=0.2
boxThreshold=0.45
unclipRatio=1.4
minConfidence=0.5
